{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>aonyx-ai/renovate-config"],
  packageRules: [
    {
      matchPackageNames: ["rust"],
      matchDepTypes: ["toolchain"],
      schedule: ["on the first day of the month"],
    },
    {
      // The tsrs crates come from one repository at one commit, and they
      // build only together. Renovate otherwise opens one pull request per
      // crate, and each one moves a single crate to a commit the others are
      // not at, so none of them builds.
      matchPackageNames: ["/^tsrs_/"],
      groupName: "tsrs",
    },
  ],
}
