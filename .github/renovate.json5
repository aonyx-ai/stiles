{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>aonyx-ai/renovate-config"],
  // `bundle-tsrs` generates crates/stiles-tsrs from the tsrs submodule, and
  // its manifest copies the exact versions that tsrs pins. Those move with
  // the submodule, so Renovate leaves the generated crate alone.
  ignorePaths: ["crates/stiles-tsrs/**"],
  packageRules: [
    {
      // A bump of the tsrs submodule changes the checker, and it fails
      // `check-bundle-tsrs` until `bundle-tsrs` runs on the branch. tsrs
      // moves often, so the submodule moves once a week, and a person
      // regenerates the bundle and merges the pull request.
      matchManagers: ["git-submodules"],
      schedule: ["on monday"],
      automerge: false,
    },
  ],
  "git-submodules": {
    enabled: true,
  },
}
