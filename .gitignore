# Compiled files and executables generated by Cargo
debug/
target/
# tsrs_core has a module named `debug`, which the pattern above would leave
# out of the bundle and out of the crate that Cargo packages.
!/crates/whisker-tsrs/**/debug/

# Release archives that the release workflow assembles
dist/

# Backup files generated by rustfmt
**/*.rs.bk

# Debugging information generated by MSVC Windows builds of rustc
*.pdb

# tsrs, which the submodule holds, follows its own rules, so the tools that
# walk the tree with these patterns, such as zizmor, skip it. The pattern
# names the files inside the submodule and not the submodule itself, so
# `git add vendor/tsrs` still stages a new commit of tsrs.
/vendor/tsrs/*
